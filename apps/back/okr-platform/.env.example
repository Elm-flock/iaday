# Base de datos
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/okr-platform?schema=public"

# App
PORT=3000
FRONT_ORIGIN="http://localhost:3001"

# Auth (generar con: openssl rand -base64 48)
JWT_ACCESS_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# Seed (npx prisma db seed): admin inicial. Obligatorias para el seed; sin valores por defecto.
# La contraseña debe tener al menos 12 caracteres. Cambiar estos placeholders.
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="cambiar-por-una-clave-de-12-o-mas"
# Opcionales (default: "Administrador" y "Organización")
# SEED_ADMIN_NAME="Administrador"
# SEED_ORG_NAME="Organización"

# Solo e2e: límite de intentos por minuto en login/refresh (default 5)
# LOGIN_THROTTLE_LIMIT=5

# IA (accesibilidad cognitiva). Con AI_ENABLED=false toda la API de /ai responde 503 AI_DISABLED.
AI_ENABLED=false
# okr-platform-agent (FastAPI). El secreto HMAC debe ser el mismo en ambos servicios (openssl rand -base64 48).
AGENT_URL="http://localhost:8088"
AGENT_SHARED_SECRET="cambiar-por-un-secreto-compartido-de-32-bytes-o-mas"
# Opcionales (defaults: 50000 ms y 20 pedidos de IA por usuario por minuto)
# AGENT_TIMEOUT_MS=125000
# AI_THROTTLE_LIMIT=20
# AI_PROMPTS_TTL_MS=60000   # caché de los prompts vigentes leídos de GET /health del agente (0 = sin caché)

# Asistente de administración (solo ADMIN; requiere AI_ENABLED=true y el agente). Con false: novedades con plantilla y chat deshabilitado.
ASSISTANT_ENABLED=false
# Opcionales (defaults: 15 min de vigencia de un plan, 120000 ms de timeout del agente, zona horaria de la organización)
# ASSISTANT_PLAN_TTL_MIN=15
# ASSISTANT_AGENT_TIMEOUT_MS=120000
# ASSISTANT_TIMEZONE="America/Argentina/Buenos_Aires"
