{
  "components": {
    "schemas": {
      "AuthSessionDto": {
        "properties": {
          "accessExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "accessToken": {
            "description": "JWT de acceso (15 min)",
            "type": "string"
          },
          "refreshExpiresAt": {
            "format": "date-time",
            "type": "string"
          },
          "refreshToken": {
            "description": "Refresh opaco rotativo (7 días deslizante, techo 30 días)",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": ["accessToken", "accessExpiresAt", "refreshToken", "refreshExpiresAt", "user"],
        "type": "object"
      },
      "AuthUserDto": {
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": ["ADMIN", "LEADER", "MEMBER"],
            "type": "string"
          }
        },
        "required": ["id", "name", "email", "role"],
        "type": "object"
      },
      "LoginDto": {
        "properties": {
          "email": {
            "example": "ana@empresa.com",
            "type": "string"
          },
          "password": {
            "example": "Password123!",
            "type": "string"
          }
        },
        "required": ["email", "password"],
        "type": "object"
      },
      "MeDto": {
        "properties": {
          "email": {
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "role": {
            "enum": ["ADMIN", "LEADER", "MEMBER"],
            "type": "string"
          },
          "teams": {
            "items": {
              "$ref": "#/components/schemas/MeTeamDto"
            },
            "type": "array"
          }
        },
        "required": ["id", "name", "email", "role", "teams"],
        "type": "object"
      },
      "MeTeamDto": {
        "properties": {
          "isLead": {
            "type": "boolean"
          },
          "name": {
            "type": "string"
          },
          "teamId": {
            "format": "uuid",
            "type": "string"
          }
        },
        "required": ["teamId", "name", "isLead"],
        "type": "object"
      },
      "RefreshDto": {
        "properties": {
          "refreshToken": {
            "description": "Refresh token opaco recibido en login/refresh",
            "type": "string"
          }
        },
        "required": ["refreshToken"],
        "type": "object"
      }
    },
    "securitySchemes": {
      "JWT-auth": {
        "bearerFormat": "JWT",
        "description": "Enter JWT token",
        "in": "header",
        "name": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "contact": {},
    "description": "Documentación de la API de okr-platform",
    "title": "okr-platform API",
    "version": "1.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/auth/login": {
      "post": {
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "Credenciales inválidas (sin distinguir email/password)"
          },
          "429": {
            "description": "Demasiados intentos"
          }
        },
        "summary": "Login con email y password",
        "tags": ["auth"]
      }
    },
    "/auth/logout": {
      "post": {
        "operationId": "AuthController_logout",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "204": {
            "description": ""
          }
        },
        "summary": "Revoca la familia del refresh token (idempotente)",
        "tags": ["auth"]
      }
    },
    "/auth/me": {
      "get": {
        "operationId": "AuthController_me",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "Token ausente, inválido o usuario desactivado"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Perfil del usuario autenticado",
        "tags": ["auth"]
      }
    },
    "/auth/refresh": {
      "post": {
        "operationId": "AuthController_refresh",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshDto"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSessionDto"
                }
              }
            },
            "description": ""
          },
          "401": {
            "description": "Refresh desconocido, vencido, reutilizado o en carrera"
          }
        },
        "summary": "Rota el refresh token y emite un nuevo access token",
        "tags": ["auth"]
      }
    },
    "/health": {
      "get": {
        "operationId": "HealthController_check",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "status": {
                      "enum": ["ok"],
                      "type": "string"
                    }
                  },
                  "required": ["status"],
                  "type": "object"
                }
              }
            },
            "description": ""
          }
        },
        "summary": "Estado del servicio",
        "tags": ["health"]
      }
    }
  },
  "servers": [],
  "tags": []
}
