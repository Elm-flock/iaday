# Entorno de tests e2e (db-test de docker-compose, puerto 55433). Sin secretos reales.
DATABASE_URL="postgresql://postgres:postgres@localhost:55433/okr-platform-test?schema=public"
PORT=3000
FRONT_ORIGIN="http://localhost:3001"
JWT_ACCESS_SECRET="test-secret-solo-para-e2e-0123456789abcdef"
LOGIN_THROTTLE_LIMIT=1000

# IA: el stub del agente se levanta dentro de cada e2e (puerto efimero) y pisa AGENT_URL.
AI_ENABLED=true
AGENT_URL="http://127.0.0.1:9"
AGENT_SHARED_SECRET="test-agent-secret-solo-para-e2e-0123456789"
AGENT_TIMEOUT_MS=5000
AI_THROTTLE_LIMIT=1000

# Asistente de administracion (usa el mismo stub del agente).
ASSISTANT_ENABLED=true
