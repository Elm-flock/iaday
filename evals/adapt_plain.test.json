{
  "endpoint": "/v1/adapt",
  "cases": [
    {
      "name": "checkin-ventas",
      "endpoint": "/v1/adapt",
      "request": {
        "level": "PLAIN",
        "entityType": "CHECK_IN",
        "locale": "es",
        "segments": [
          {
            "key": "checkin.kr_title",
            "text": "Incrementar la tasa de conversión del embudo B2B del 3,2 % al 5 %"
          },
          {
            "key": "checkin.note",
            "text": "Se optimizó el onboarding comercial; la conversión subió a 4,1 % pero persiste fricción en la etapa de demo, que revisaremos el 20/11."
          }
        ],
        "mustPreserve": [
          "3,2 %",
          "5 %",
          "4,1 %",
          "20/11"
        ]
      },
      "expect": {
        "status": 200,
        "numbersPreserved": true,
        "minSzigriszt": 55,
        "noRawEnumTokens": true
      }
    },
    {
      "name": "objetivo-calidad",
      "endpoint": "/v1/adapt",
      "request": {
        "level": "PLAIN",
        "entityType": "OBJECTIVE",
        "locale": "es",
        "segments": [
          {
            "key": "objective.title",
            "text": "Garantizar una experiencia de producto estable y predecible"
          },
          {
            "key": "objective.description",
            "text": "Disminuir los defectos escapados a producción de 12 a 4 por trimestre mediante automatización de pruebas de regresión."
          }
        ],
        "mustPreserve": [
          "12",
          "4"
        ]
      },
      "expect": {
        "status": 200,
        "numbersPreserved": true,
        "minSzigriszt": 55,
        "noRawEnumTokens": true
      }
    },
