# Copiar a .env y completar. NUNCA commitear .env ni claves reales.

# --- NVIDIA NIM (https://build.nvidia.com) ---
NVIDIA_NIM_API_KEY=
# Opcional; por defecto el de config/models.yaml
# NVIDIA_NIM_API_BASE=https://integrate.api.nvidia.com/v1

# --- Autenticacion HMAC con NestJS (mismo valor en ambos servicios, >= 32 bytes aleatorios) ---
AGENT_SHARED_SECRET=

# --- Servicio ---
AGENT_PORT=8088
AGENT_MAX_CONCURRENCY=4
AGENT_REQUEST_DEADLINE_S=120
AGENT_LOG_LEVEL=INFO
# Carpeta con config/ y prompts/ (por defecto la raiz del repo)
# AGENT_HOME=

# --- Overrides de modelos (VERIFICAR vigencia en build.nvidia.com) ---
# AGENT_MODEL_CLASSIFY=
# AGENT_MODEL_CLASSIFY_FALLBACK=
# AGENT_MODEL_GENERATE=
# AGENT_MODEL_GENERATE_FALLBACK=
# AGENT_MODEL_JUDGE=
# AGENT_MODEL_JUDGE_FALLBACK=

# --- Langfuse (opcional; sin estas variables la telemetria es no-op) ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
